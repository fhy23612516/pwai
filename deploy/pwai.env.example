# Copy this file to /etc/pwai/pwai.env on the server.
HOST=0.0.0.0
PORT=4188
NODE_ENV=production
MAX_BODY_BYTES=65536
APP_STATE_MAX_BYTES=1048576
AI_TIMEOUT_MS=30000
AI_HTTP_CLIENT=fetch

# Account login. Users register on /login and are stored on the server.
# Generate AUTH_SESSION_SECRET with: openssl rand -hex 32
AUTH_USERS_FILE=/etc/pwai/users.json
AUTH_DATA_FILE=/etc/pwai/app-data.json
ACCESS_LOG_FILE=/etc/pwai/access-log.json
ACCESS_LOG_MAX_ENTRIES=1000
AUTH_ALLOW_REGISTRATION=true
AUTH_ADMIN_USERS=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_NAME=pwai_session
AUTH_COOKIE_SECURE=true

# Reserved for remote AI provider.
# Do not commit real keys to Git.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_PREP=
OPENAI_MODEL_ASSIST=
OPENAI_MODEL_SIMULATE=
OPENAI_MODEL_REVIEW=
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_REASONING_EFFORT=
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_RESPONSE_FORMAT=json_object

# Use "chat" for most OpenAI-compatible relay providers.
# Use "responses" only when the provider supports /v1/responses.
AI_API_MODE=chat
