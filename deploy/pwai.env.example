# Copy this file to /etc/pwai/pwai.env on the server.
HOST=0.0.0.0
PORT=4188
NODE_ENV=production
MAX_BODY_BYTES=65536
AI_TIMEOUT_MS=30000
AI_HTTP_CLIENT=fetch

# Reserved for remote AI provider.
# Do not commit real keys to Git.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_REASONING_EFFORT=
OPENAI_DISABLE_RESPONSE_STORAGE=true

# Use "chat" for most OpenAI-compatible relay providers.
# Use "responses" only when the provider supports /v1/responses.
AI_API_MODE=chat
